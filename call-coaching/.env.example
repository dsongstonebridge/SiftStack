# Copy to call-coaching\.env and fill in. .env is gitignored; never commit it.

# Transcription (Gemini 2.5 Flash via OpenRouter, about $0.003 per audio minute)
OPENROUTER_API_KEY=

# smrtPhone API token (Settings > API). Backup only: used to look up a recording
# when DataSift logged the call SID but no recording link.
SMRTPHONE_API_TOKEN=

# Optional. Read from SiftStack\.env if not set here.
# DATASIFT_API_KEY=
